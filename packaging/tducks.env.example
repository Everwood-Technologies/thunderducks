# /etc/thunderducks/tducks.env — optional overrides for tducks.service
# Copy: sudo cp packaging/tducks.env.example /etc/thunderducks/tducks.env
# Docs: docs/remote-access.md

# RPC bind (Pond DIY default: loopback only)
TD_BIND=127.0.0.1:8788

# Data directory (must be writable by user tducks)
# Holds: identity.key, claim.json, events.sqlite, e2ee.json, meta.json
# (pair tokens + owner sessions stay in-memory — re-unlock after restart)
TD_DATA_DIR=/var/lib/thunderducks

# --- Remote access (optional) ---
# Advertise tailnet/LAN host in rpc_base + p2p_uri (no port = use bound port)
# TD_ADVERTISE_HOST=100.x.y.z
#
# P2P listen for off-box peers (default is loopback ephemeral)
# TD_P2P_BIND=0.0.0.0:0
#
# Untrusted assist relay (td://host:port or td-noise://host:port)
# TD_RELAY_URI=td://relay.example:7700
# Fallback shared AEAD seal key (v1) when Olm session missing.
# Prefer per-recipient Olm (v2) via /v1/e2ee/trust-keys after peers exchange keys.
# TD_RELAY_KEY=change-me-to-a-long-random-secret
# Prefer Noise_XX for P2P (advertise td-noise://)
# TD_P2P_NOISE=true
# Prefer QUIC P2P (advertise td-quic://; takes precedence over noise)
# TD_P2P_QUIC=true
# QUIC identity (auto under TD_DATA_DIR if unset)
# TD_QUIC_CERT=/var/lib/thunderducks/quic-cert.pem
# TD_QUIC_KEY=/var/lib/thunderducks/quic-key.pem
# Peer pins: blake3 of peer leaf cert DER (64 hex), comma-separated
# TD_QUIC_PINS=
# mTLS (default on when pins set)
# TD_QUIC_MTLS=true
#
# In-process HTTPS for RPC (PEM paths, or self-signed for dev)
# TD_TLS_CERT=/etc/ssl/pond.crt
# TD_TLS_KEY=/etc/ssl/pond.key
# TD_TLS_SELF_SIGNED=false
#
# When TD_BIND is non-loopback, require owner session for non-public routes (default true)
# TD_REQUIRE_OWNER=true
#
# Per-IP rate limits (default true). Disable only for local load tests.
# TD_RATE_LIMIT=true
#
# --- OTA / Wi-Fi (appliance) ---
# TD_OTA_MANIFEST_URL=https://updates.example/pond/stable.json
# TD_OTA_CHANNEL=stable
# TD_OTA_PUBKEY=<64 hex chars ed25519 verifying key>
# Auto-apply: write pending.json + kick tducks-ota-apply.service (default true)
# TD_OTA_AUTO_APPLY=true
# Restart unit after helper installs/rolls back binary (default true)
# TD_OTA_RESTART=true
# Keep previous binary for POST /v1/ota/rollback (default true)
# TD_OTA_KEEP_PREVIOUS=true
# TD_OTA_BIN_PATH=/usr/bin/tducks
# TD_OTA_UNIT=tducks.service
# TD_WIFI_IFACE=wlan0
