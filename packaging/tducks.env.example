# /etc/thunderducks/tducks.env — optional overrides for tducks.service
# Copy: sudo cp packaging/tducks.env.example /etc/thunderducks/tducks.env

# RPC bind (Pond DIY default: loopback only)
TD_BIND=127.0.0.1:8788

# Data directory (must be writable by user tducks)
TD_DATA_DIR=/var/lib/thunderducks

# Future: TD_P2P_BIND, TD_RELAY_URL, etc.
