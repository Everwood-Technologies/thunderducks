# /etc/thunderducks/tducks.env — optional overrides for tducks.service
# Copy: sudo cp packaging/tducks.env.example /etc/thunderducks/tducks.env
# Docs: docs/remote-access.md

# RPC bind (Pond DIY default: loopback only)
TD_BIND=127.0.0.1:8788

# Data directory (must be writable by user tducks)
# Holds: identity.key (ed25519 seed), claim.json (owner claim; recovery hash only)
TD_DATA_DIR=/var/lib/thunderducks

# --- Remote access (optional) ---
# Advertise tailnet/LAN host in rpc_base + p2p_uri (no port = use bound port)
# TD_ADVERTISE_HOST=100.x.y.z
#
# P2P listen for off-box peers (default is loopback ephemeral)
# TD_P2P_BIND=0.0.0.0:0
#
# Untrusted assist relay (td://host:port)
# TD_RELAY_URI=td://relay.example:7700
# TD_RELAY_PAD=60
#
# When TD_BIND is non-loopback, require owner session for admin routes (default true)
# TD_REQUIRE_OWNER=true
